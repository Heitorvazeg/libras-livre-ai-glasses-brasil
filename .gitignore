# Dados brutos e derivados — pesados, não versionar
data/raw/*
data/landmarks/*
!data/**/.gitkeep

# Índice dos .zip remotos do Kaggle (regenerável) — computer-vision-model/datasets/
.cache/

# Artefatos treinados
