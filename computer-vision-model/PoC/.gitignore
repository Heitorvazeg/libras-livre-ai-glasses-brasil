# Dados da PoC — pesados e/ou sensíveis (vídeos de participantes), não versionar.
data/raw/*
data/landmarks/*
!data/**/.gitkeep

# Resultados gerados: o relatório e a matriz de confusão SÃO entregáveis (§10) e
# podem ser versionados; cache de distâncias e predições clipe a clipe, não.
results/*
!results/.gitkeep
!results/relatorio.md
!results/confusion_matrix.png

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
